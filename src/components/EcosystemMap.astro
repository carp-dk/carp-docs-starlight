---
// The CARP ecosystem: phone, server and researcher tools. Boxes link to their docs.
const box = (title: string, sub: string, href?: string, kind = '') => ({ title, sub, href, kind });
const phone = {
	app: box('Your app', 'or the CARP Studies App', '/start/run-your-study/', 'accent'),
	plugins: [
		box('Sampling packages', 'health · context · survey · audio …', '/sampling-packages/health/'),
		box('Wearables', 'Apple Watch · Polar · Movesense …', '/wearables/apple-watch/'),
		box('CAWS client', 'carp_backend · carp_webservices', '/backends/carp-backend/'),
	],
	cams: box('CARP Mobile Sensing', 'runs the study on the phone', '/carp-mobile-sensing/', 'accent'),
	core: box('carp_core', 'protocols · devices · triggers · tasks · measures', '/start/components/', 'base'),
};
const server = [
	box('CAWS', 'CARP Web Services: studies and data', '/backends/where-data-goes/caws/', 'accent'),
	box('carp.core-kotlin', 'same domain model, server side', 'https://github.com/carp-dk/carp.core-kotlin', 'base'),
	box('Gardener', 'Fitbit · Garmin · Withings · Dexcom', 'https://github.com/carp-dk/carp-gardener', 'muted'),
];
const tools = [
	box('CARP Portal', 'set up studies, invite, export', 'https://github.com/carp-dk/carp-portal'),
	box('carp-cli', 'terminal and Python', 'https://github.com/carp-dk/carp-cli'),
	box('CARP DSP', 'data-science pipelines', 'https://github.com/carp-dk/carp-dsp'),
];
---

{/* prettier-ignore */}
{(() => {
	const Box = ({ b }: { b: ReturnType<typeof box> }) => b; // typing helper only
	return null;
})()}

<figure class="eco not-content" aria-label="CARP ecosystem map">
	<section class="lane">
		<h4>On the phone</h4>
		<a class={`node ${phone.app.kind}`} href={phone.app.href}><b>{phone.app.title}</b><span>{phone.app.sub}</span></a>
		<div class="down" aria-hidden="true"></div>
		<div class="row">
			{phone.plugins.map((b) => <a class={`node ${b.kind}`} href={b.href}><b>{b.title}</b><span>{b.sub}</span></a>)}
		</div>
		<div class="down" aria-hidden="true"></div>
		<a class={`node ${phone.cams.kind}`} href={phone.cams.href}><b>{phone.cams.title}</b><span>{phone.cams.sub}</span></a>
		<a class={`node ${phone.core.kind}`} href={phone.core.href}><b>{phone.core.title}</b><span>{phone.core.sub}</span></a>
	</section>

	<div class="link v" aria-hidden="true"><span>study to the phone</span><i></i><span>data to the server</span></div>

	<section class="lane">
		<h4>Server</h4>
		{server.map((b) => <a class={`node ${b.kind}`} href={b.href}><b>{b.title}</b><span>{b.sub}</span></a>)}
	</section>

	<div class="link" aria-hidden="true"><span>set up</span><i></i><span>export</span></div>

	<section class="lane">
		<h4>Researcher tools</h4>
		{tools.map((b) => <a class={`node ${b.kind}`} href={b.href}><b>{b.title}</b><span>{b.sub}</span></a>)}
	</section>
</figure>

<style>
.eco {
display: grid;
grid-template-columns: 1fr auto 1fr;
gap: 0.5rem;
margin-block: 1.5rem;
font-size: var(--sl-text-sm);
}
.eco > .lane:first-child, .link.v { grid-column: 1 / -1; }
.lane {
display: flex;
flex-direction: column;
gap: 0.5rem;
padding: 0.75rem;
border: 1px dashed var(--sl-color-gray-5);
border-radius: 0.75rem;
}
h4 {
margin: 0 0 0.25rem;
font-size: var(--sl-text-xs);
font-weight: 600;
letter-spacing: 0.06em;
text-transform: uppercase;
color: var(--sl-color-gray-3);
}
.row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.5rem; }
.node {
display: flex;
flex-direction: column;
gap: 0.15rem;
padding: 0.55rem 0.75rem;
border: 1px solid var(--sl-color-gray-5);
border-radius: 0.5rem;
background: var(--sl-color-gray-6);
color: var(--sl-color-white);
text-decoration: none;
line-height: 1.35;
transition: border-color 0.15s, transform 0.15s;
}
.node:hover { border-color: var(--sl-color-accent); transform: translateY(-1px); }
.node span { color: var(--sl-color-gray-3); font-size: var(--sl-text-xs); }
.node.accent { background: var(--sl-color-accent-low); border-color: var(--sl-color-accent); }
.node.accent span { color: var(--sl-color-gray-2); }
.node.base, .node.muted { background: transparent; }
.node.muted { border-style: dashed; }
.down { align-self: center; width: 1px; height: 0.6rem; background: var(--sl-color-gray-4); position: relative; }
.down::after {
content: ''; position: absolute; left: -4px; bottom: -4px;
border: 4px solid transparent; border-top-color: var(--sl-color-gray-4);
}
/* two-way arrows between lanes */
.link {
display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 0.3rem;
color: var(--sl-color-gray-3); font-size: var(--sl-text-xs);
}
.link i { display: block; width: 2.5rem; height: 1px; background: var(--sl-color-gray-4); position: relative; }
.link i::before, .link i::after { content: ''; position: absolute; top: -4px; border: 4px solid transparent; }
.link i::before { left: -4px; border-right-color: var(--sl-color-gray-4); }
.link i::after { right: -4px; border-left-color: var(--sl-color-gray-4); }
.link.v { flex-direction: row; gap: 0.75rem; }
.link.v i { width: 1px; height: 1.75rem; }
.link.v i::before { left: -4px; top: -4px; border-color: transparent; border-bottom-color: var(--sl-color-gray-4); }
.link.v i::after { left: -4px; right: auto; top: auto; bottom: -4px; border-color: transparent; border-top-color: var(--sl-color-gray-4); }

@media (max-width: 40rem) {
.eco { grid-template-columns: 1fr; }
.row { grid-template-columns: 1fr; }
.link:not(.v) { flex-direction: row; }
.link:not(.v) i { width: 1px; height: 1.5rem; }
.link:not(.v) i::before { left: -4px; top: -4px; border-color: transparent; border-bottom-color: var(--sl-color-gray-4); }
.link:not(.v) i::after { left: -4px; right: auto; top: auto; bottom: -4px; border-color: transparent; border-top-color: var(--sl-color-gray-4); }
}
</style>
